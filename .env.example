# ═══════════════════════════════════════════════════════════════════
# .env.example — Copy file này thành .env và điền giá trị thật
# File .env KHÔNG được commit vào git (đã có trong .gitignore)
# ═══════════════════════════════════════════════════════════════════

APP_PROFILE=dev

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/phukienrom_dev
DB_USERNAME=postgres
DB_PASSWORD=your-db-password-here

# JWT — tạo random string >= 64 chars
# Linux/Mac: openssl rand -base64 64
JWT_SECRET=replace-with-random-64-char-string-never-use-this-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Business config
ORDER_CANCEL_WINDOW_HOURS=24
LOW_STOCK_THRESHOLD=5
